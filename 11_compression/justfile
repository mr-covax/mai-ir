set shell := ["bash", "-euo", "pipefail", "-c"]

_default:
    @just --list

build-index:
    @./build/positional build

search:
    @./build/positional search

build-raw:
    @./build/positional build-raw

measure-raw:
    @./build/positional measure-raw

measure-vb:
    @./build/positional measure-vb

summary:
    @uv run --locked python tools/summary.py

measure:
    @./build/positional measure-raw
    @./build/positional measure-vb
    @uv run --locked python tools/summary.py

build:
    @cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF >&2
    @cmake --build build --parallel 2 >&2

alias make := build

[private]
test:
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON
    cmake --build build --parallel 2
    ctest --test-dir build --output-on-failure

[private]
clean:
    rm -rf build
